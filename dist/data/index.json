ext":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":[],"video":"","videoTitle":"","videoSearch":"JavaScript execution context hoisting visualized"},"js-closures":{"title":"Scope and closures","line":"js","n":2,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"authentication-and-authorization","sectionText":"Authentication and authorization"}],"summary":"A function remembers the variables around the place it was written, even after that place has finished running. Private state, React hooks, debounce and middleware factories all rest on this.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["js-execution-context"],"video":"","videoTitle":"","videoSearch":"JavaScript closures visualized Lydia Hallie"},"js-this":{"title":"this, call, apply, bind","line":"js","n":3,"ready":true,"usedIn":[],"summary":"The value of this is not decided where a function is written. It is decided at the moment the function is called. Four rules cover every case.","time":"25","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["js-execution-context","js-closures"],"video":"","videoTitle":"","videoSearch":"JavaScript this keyword call apply bind explained"},"js-prototypes":{"title":"Prototypes and classes","line":"js","n":4,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"class-diagram","sectionText":"Class diagram"}],"summary":"JavaScript objects inherit by linking to other objects. Classes are a cleaner syntax over that same link.","time":"25","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["js-this"],"video":"","videoTitle":"","videoSearch":"JavaScript prototypes prototype chain explained"},"js-event-loop":{"title":"The event loop","line":"js","n":5,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"architecture","sectionText":"Architecture"},{"project":"collab-editor","title":"Real-time collaborative editor","section":"real-time-sync-the-core-problem","sectionText":"Real-time sync: the core problem"}],"summary":"JavaScript runs one thing at a time, yet handles timers, network calls and clicks without freezing. The event loop is the scheduler that makes this work, and its ordering rules are asked in almost every interview.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["js-execution-context"],"video":"eiC58R16hb8","videoTitle":"JavaScript Visualized: Event Loop, Web APIs, (Micro)task Queue, by Lydia Hallie (about 13 min)","videoSearch":"The event loop explained"},"js-promises":{"title":"Promises and async/await","line":"js","n":6,"ready":true,"usedIn":[],"summary":"A promise is an object that stands for a result you do not have yet. Chaining, error handling and running work in parallel all follow from three states and one scheduling rule.","time":"35","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["js-event-loop"],"video":"Xs1EMmBLpn4","videoTitle":"JavaScript Visualized: Promise Execution, by Lydia Hallie (about 9 min)","videoSearch":"Promises and async/await explained"},"js-values":{"title":"Values, references, equality","line":"js","n":7,"ready":true,"usedIn":[],"summary":"Primitives are copied, objects are shared by reference. That one distinction explains equality surprises, accidental mutation and why React asks you to never mutate state.","time":"25","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":[],"video":"","videoTitle":"","videoSearch":"JavaScript value vs reference shallow copy deep copy explained"},"js-functional":{"title":"Higher-order functions, debounce, throttle","line":"js","n":8,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"persistence-and-autosave","sectionText":"Persistence and autosave"},{"project":"collab-editor","title":"Real-time collaborative editor","section":"frontend","sectionText":"Frontend"}],"summary":"Functions that take or return functions. Once closures click, map/filter/reduce, debounce, throttle and currying are small variations of one idea, and all four are standard interview coding questions.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["js-closures","js-event-loop"],"video":"","videoTitle":"","videoSearch":"debounce vs throttle JavaScript explained animation"},"node-runtime":{"title":"How Node runs your code","line":"node","n":1,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"architecture","sectionText":"Architecture"}],"summary":"Node is V8 plus libuv. One thread runs your JavaScript, the operating system and a small thread pool do the waiting. Knowing which work goes where tells you what Node is good at and what will freeze it.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["js-event-loop","js-promises"],"video":"","videoTitle":"","videoSearch":"Node.js event loop libuv phases explained animation"},"express-middleware":{"title":"Express and the middleware chain","line":"node","n":2,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"architecture","sectionText":"Architecture"}],"summary":"An Express app is a list of functions that a request passes through in order. Routing, body parsing, authentication and error handling are all the same mechanism.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["node-runtime","js-closures"],"video":"","videoTitle":"","videoSearch":"Express middleware explained next function"},"rest-api":{"title":"REST API design","line":"node","n":3,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"architecture","sectionText":"Architecture"}],"summary":"REST is a set of conventions that make an HTTP API predictable. Resources are nouns, methods are verbs, status codes report the outcome, and idempotency keeps retries safe.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["express-middleware"],"video":"","videoTitle":"","videoSearch":"REST API design best practices status codes idempotency"},"auth-jwt":{"title":"Authentication: hashing, sessions, JWT","line":"node","n":4,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"authentication-and-authorization","sectionText":"Authentication and authorization"}],"summary":"Proving who a user is, remembering it across requests, and deciding what they may do. Password hashing, sessions vs tokens, the JWT format and where it breaks.","time":"40","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"part-1-storing-passwords","text":"Part 1: storing passwords"},{"id":"part-2-staying-logged-in-sessions-vs-tokens","text":"Part 2: staying logged in, sessions vs tokens"},{"id":"part-3-what-a-jwt-is","text":"Part 3: what a JWT is"},{"id":"part-4-the-full-flow-in-express","text":"Part 4: the full flow in Express"},{"id":"part-5-access-and-refresh-tokens","text":"Part 5: access and refresh tokens"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["express-middleware","rest-api"],"video":"UBUNrFtufWo","videoTitle":"Session vs Token Authentication in 100 Seconds, by Fireship","videoSearch":"Authentication: hashing, sessions, JWT explained"},"websockets":{"title":"WebSockets and real-time","line":"node","n":5,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"architecture","sectionText":"Architecture"},{"project":"collab-editor","title":"Real-time collaborative editor","section":"scaling-beyond-one-server","sectionText":"Scaling beyond one server"}],"summary":"HTTP only speaks when the client asks. A WebSocket is one long-lived connection where either side can send at any time, which is what chat, live cursors and collaborative editing need.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"scaling-past-one-server","text":"Scaling past one server"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["node-runtime","auth-jwt"],"video":"","videoTitle":"","videoSearch":"WebSockets explained in 100 seconds"},"node-scaling":{"title":"Scaling Node: queues, caching, rate limits","line":"node","n":6,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"scaling-beyond-one-server","sectionText":"Scaling beyond one server"}],"summary":"What to do when one Node process is not enough. Use every core, move slow work to a queue, cache what is read often and limit what any one client can ask for.","time":"35","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"tool-1-use-every-core","text":"Tool 1: use every core"},{"id":"tool-2-background-jobs-with-a-queue","text":"Tool 2: background jobs with a queue"},{"id":"tool-3-caching","text":"Tool 3: caching"},{"id":"tool-4-rate-limiting","text":"Tool 4: rate limiting"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["node-runtime","rest-api"],"video":"","videoTitle":"","videoSearch":"system design caching rate limiting message queue animation ByteByteGo"},"mongo-modeling":{"title":"Documents and data modeling","line":"mongo","n":1,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"data-model","sectionText":"Data model"}],"summary":"MongoDB stores JSON-like documents. The central design decision is whether related data lives inside one document or in separate documents linked by id, and the answer comes from how the app reads it.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-decision-rule","text":"The decision rule"},{"id":"practice","text":"Practice"}],"needs":[],"video":"","videoTitle":"","videoSearch":"MongoDB schema design embedding vs referencing explained"},"mongo-indexes":{"title":"Indexes and query plans","line":"mongo","n":2,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"data-model","sectionText":"Data model"}],"summary":"Without an index the database reads every document to answer a query. An index is a sorted structure that lets it jump straight to the matches, at the cost of slower writes.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["mongo-modeling"],"video":"","videoTitle":"","videoSearch":"MongoDB indexes compound index ESR rule explain"},"mongo-aggregation":{"title":"The aggregation pipeline","line":"mongo","n":3,"ready":true,"usedIn":[],"summary":"find returns documents as they are stored. The aggregation pipeline reshapes them: filter, group, join and compute in a sequence of stages, each feeding the next.","time":"25","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["mongo-modeling","mongo-indexes"],"video":"","videoTitle":"","videoSearch":"MongoDB aggregation pipeline explained animation"},"mongo-transactions":{"title":"Transactions, replication, sharding","line":"mongo","n":4,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"persistence-and-autosave","sectionText":"Persistence and autosave"}],"summary":"What MongoDB guarantees when several documents must change together, when a server dies, and when the data no longer fits on one machine.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"part-1-atomicity-single-document-first","text":"Part 1: atomicity, single document first"},{"id":"part-2-multi-document-transactions","text":"Part 2: multi-document transactions"},{"id":"part-3-replication","text":"Part 3: replication"},{"id":"part-4-sharding","text":"Part 4: sharding"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["mongo-modeling","mongo-indexes"],"video":"","videoTitle":"","videoSearch":"MongoDB replica set sharding explained animation"},"react-rendering":{"title":"Rendering, reconciliation, keys","line":"react","n":1,"ready":true,"usedIn":[],"summary":"In React you describe what the screen should look like for the current data. React works out the smallest set of DOM changes. Rendering, reconciliation and keys explain when and why that happens.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["js-values","js-functional"],"video":"","videoTitle":"","videoSearch":"React rendering reconciliation virtual DOM keys explained"},"react-state":{"title":"State, props and hooks","line":"react","n":2,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"frontend","sectionText":"Frontend"}],"summary":"Props flow down, state lives inside, and every render sees its own frozen copy of both. That snapshot idea explains batching, stale values and why state must never be mutated.","time":"30","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rules-of-hooks-and-why-they-exist","text":"The rules of hooks, and why they exist"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["react-rendering","js-closures"],"video":"","videoTitle":"","videoSearch":"React useState snapshot batching explained"},"react-effects":{"title":"Effects and the component lifecycle","line":"react","n":3,"ready":true,"usedIn":[{"project":"collab-editor","title":"Real-time collaborative editor","section":"frontend","sectionText":"Frontend"}],"summary":"Rendering must be pure, yet apps need to fetch data, open sockets and start timers. useEffect is where a component synchronizes with the world outside React, and its dependency array and cleanup are where most bugs live.","time":"35","headings":[{"id":"the-problem-this-solves","text":"The problem this solves"},{"id":"intuition","text":"Intuition"},{"id":"build-it-step-by-step","text":"Build it step by step"},{"id":"the-rule-stated-precisely","text":"The rule, stated precisely"},{"id":"practice","text":"Practice"}],"needs":["react-state","js-promises"],"video":"","videoTitle":"","videoSearch":"React useEffect dependency array cleanup explained"},"react-